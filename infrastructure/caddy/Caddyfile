{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2 h3
	}
}

{$N8N_HOST} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Public: only production webhook routes (Loopmend → recovery executor).
	@webhooks path /webhook/*
	handle @webhooks {
		request_body {
			max_size 512KB
		}
		reverse_proxy n8n:5678
	}

	# Editor, REST and public API: restricted to operator IPs.
	@operators remote_ip {$EDITOR_ALLOWED_IPS}
	handle @operators {
		reverse_proxy n8n:5678
	}

	handle {
		respond "Not found" 404
	}

	log {
		output file /data/access.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
