# Copy to infrastructure/docker/.env  (never commit the real file)
N8N_HOST=n8n.example.com
ACME_EMAIL=ops@example.com
N8N_VERSION=2.47.7
# openssl rand -hex 32
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
# Comma/space separated CIDRs allowed to reach the n8n editor UI
EDITOR_ALLOWED_IPS=203.0.113.10/32

# From Loopmend → Settings → n8n integrations (shown once on creation)
LOOPMEND_URL=https://loopmend.example.vercel.app
LOOPMEND_INTEGRATION_ID=
LOOPMEND_WEBHOOK_SECRET=
# Same value as CRON_SECRET in the Loopmend deployment
LOOPMEND_CRON_SECRET=
# n8n Settings → n8n API (used by the recovery executor to retry/deactivate)
N8N_PUBLIC_API_KEY=
SLACK_WEBHOOK_URL=
