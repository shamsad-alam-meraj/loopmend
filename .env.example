# ---------------------------------------------------------------------------
# Loopmend environment. Copy to .env.local and fill in what you need.
# Everything is optional for local development: without DATABASE_URL an
# embedded PGlite database is used, without Supabase a local demo auth is
# used, and without GEMINI_API_KEY a deterministic rules-based analyzer runs.
# NEVER prefix secrets with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional runtime override for server-to-self calls (failure simulator). NEXT_PUBLIC_* is inlined at build time.
LOOPMEND_INTERNAL_URL=
NODE_ENV=development

# Supabase (Auth + Realtime). Leave empty to use local demo auth.
NEXT_PUBLIC_SUPABASE_URL=
# New keys (sb_publishable_…); the legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database. postgres://… for Supabase/Postgres; empty = embedded PGlite in ./.data/pglite
DATABASE_URL=
# Optional: path for the embedded PGlite database
PGLITE_DATA_DIR=./.data/pglite

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# n8n
N8N_BASE_URL=
N8N_WEBHOOK_URL=
N8N_API_KEY=
# Shared HMAC secret for n8n -> Loopmend and Loopmend -> n8n webhooks (>= 32 chars)
N8N_WEBHOOK_SECRET=dev-only-webhook-secret-change-me-0123456789

# Sustained webhook events/second per integration (burst 4x)
WEBHOOK_RATE_LIMIT_PER_SEC=50

# Security
# 32-byte key, base64 encoded:  openssl rand -base64 32
ENCRYPTION_KEY=
# Session signing secret for local demo auth (>= 32 chars)
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
CRON_SECRET=

# Monitoring
SENTRY_DSN=

# Demo: allow the one-click demo login + failure simulator (default true outside production)
ENABLE_DEMO_MODE=true
